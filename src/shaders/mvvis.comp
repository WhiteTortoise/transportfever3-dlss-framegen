#version 450
#extension GL_GOOGLE_include_directive : require
// Debug view at half resolution: grey = no motion, red/green = horizontal /
// vertical motion, brightness of the scene mixed in for orientation.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1) uniform sampler2D curTex;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D mvIn;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D visOut;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    ivec2 p = q * 2;
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) {
        return;
    }
    vec2 mvPixels = imageLoad(mvIn, p).xy * pc.size;
    vec3 motion = vec3(0.5 + mvPixels.x / 40.0, 0.5 + mvPixels.y / 40.0, 0.5);
    float scene = Luma(texelFetch(curTex, p, 0).rgb);
    imageStore(visOut, q, vec4(mix(clamp(motion, 0.0, 1.0), vec3(scene), 0.25), 1.0));
}
